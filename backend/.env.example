# Server
NODE_ENV=production
PORT=3001

# Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/database
# Or use individual variables:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=photofind

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-url.com

# Google OAuth (same Client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# PayMongo. Optional in development; REQUIRED when NODE_ENV=production - the server refuses
# to start if any of these is missing, still a placeholder, or the two keys are from
# different modes (sk_live_ with pk_test_ or the reverse). See src/config/paymongoConfig.ts.
# FRONTEND_URL above must also be set, and https, in production: it is where PayMongo
# returns the client after paying.
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_PUBLIC_KEY=pk_test_xxx
# From the webhook you register in the PayMongo dashboard (Developers > Webhooks). Live and
# test webhooks have DIFFERENT secrets - use the one that matches the keys above.
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# How long one PayMongo API call may take before it is abandoned, in milliseconds.
PAYMONGO_TIMEOUT_MS=15000
# How long a payment may sit pending/processing before the reconciliation sweep asks
# PayMongo about it (minutes). Keep it longer than the QR expiry below.
PAYMENT_RECONCILE_AFTER_MINUTES=20
# QR Ph is the only online payment method offered. This is the break-glass switch:
# false drops QR Ph and falls back to card + GCash + GrabPay + PayMaya, for a QR Ph outage
# or an account that has lost the capability. Leave it true in normal operation.
PAYMONGO_QRPH_ENABLED=true
# How long a QR Ph code stays scannable. PayMongo accepts 60-9000; default here is 900.
PAYMONGO_QRPH_EXPIRY_SECONDS=900
PLATFORM_COMMISSION_RATE=0.15
MINIMUM_PAYOUT_AMOUNT=500
